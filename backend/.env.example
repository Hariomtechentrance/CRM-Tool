# ── BL-CRM Backend — copy to .env and fill in your values ───

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/blcrm?schema=public"

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development        # Change to "production" when deploying

# ── JWT Secrets — MUST be long random strings in production ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_use_a_64char_random_string
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_64char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL (for CORS + email links) ────────────────────
# Comma-separated for multiple origins: https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:5173

# ── Auth cookies ─────────────────────────────────────────────
# The refresh token is delivered as an httpOnly cookie. If the frontend and this
# API are on DIFFERENT domains (e.g. two *.onrender.com hosts, or Vercel+Render),
# set this to "none" or the browser will not send the cookie on XHR and login
# will fail. "none" requires HTTPS. Leave "lax" if they share a domain
# (app.example.com + api.example.com).
AUTH_COOKIE_SAMESITE=lax

# ── RBAC enforcement ─────────────────────────────────────────
# The permission matrix in src/config/permissions.ts is REPORT-ONLY until this
# is "true": denials are logged (console + audit action RBAC_WOULD_BLOCK) but
# the request still proceeds. Deploy, watch the logs for a release cycle to
# catch false positives, then set RBAC_ENFORCE=true to actually block.
RBAC_ENFORCE=false

# ── AI Support Assistant (BusinessOS Assistant chat widget) ──
# Free key: console.groq.com → API Keys. Without this set, /api/chatbot/chat
# returns 503 "AI service not configured" and the chat widget shows that error.
GROQ_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────
# Gmail: use an App Password (not your real password)
# Other: use any SMTP provider (Mailgun, SendGrid, Brevo, etc.)
# Only used as a fallback — if RESEND_API_KEY (below) is set, sendEmail()
# uses that instead and SMTP is never touched.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587               # 587 for STARTTLS, 465 for SSL
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="BL-CRM <noreply@yourdomain.com>"

# ── Email (Resend) — preferred over SMTP when set ─────────────
# resend.com → API Keys. Checked before SMTP in sendEmail(); if unset,
# falls back to the SMTP_* vars above.
RESEND_API_KEY=

# ── Redis (rate-limit store, cross-worker cache, cluster mode) ─
# Without this set, cacheService/rate-limit stores silently fall back to
# per-process-only state — this still runs, but under Render's cluster
# mode (multiple workers) each worker has its own cache/limiter counts
# instead of a shared one, which can reintroduce bugs that look like
# "works sometimes" (stale module-access grants, rate limits that don't
# actually cap total traffic, refresh-token rotation races). Required for
# correct behavior in production; safe to leave unset for local dev.
REDIS_URL=

# ── Firebase Admin (phone-number OTP verification) ────────────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Without these set, phone-OTP login/linking fails — email/
# password and email-OTP login are unaffected.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── WhatsApp Cloud API webhook security ────────────────────────
# One Meta App serves every org's WhatsApp number through the single
# /api/whatsapp/webhook URL (orgs are matched by phoneNumberId in each
# payload, not by the app) — so these two are app-level, not per-org.
# WHATSAPP_APP_SECRET: Meta App Dashboard → Settings → Basic → App Secret.
#   Used to verify the X-Hub-Signature-256 header on every inbound webhook
#   POST. Without this set, signature verification is DISABLED — anyone
#   who finds the webhook URL can POST forged WhatsApp events. Set this.
# WHATSAPP_VERIFY_TOKEN: any string you choose; re-enter the SAME string
#   as the Verify Token when subscribing the webhook in Meta's dashboard.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
